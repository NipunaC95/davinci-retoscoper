{
	Tools = ordered() {
		Retscope = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "Transform1",
					Source = "Input",
					Name = "Source",
				},
				AspectPreset = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn1",
					Name = "Target Aspect Ratio",
					INPID_InputControl = "ComboControl",
					INP_Integer = true,
					INP_Default = 5,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 9,
					INP_MinScale = 0,
					INP_MaxScale = 9,
					LINKS_Name = "Target Aspect Ratio",
					LINKID_DataType = "Number",
					INPID_PreviewControl = "ComboControl",
				},
				CustomAspect = InstanceInput {
					SourceOp = "Expression1",
