					INPID_InputControl = "SliderControl",
					INP_Default = 1.0,
					INP_MinAllowed = 1.0,
					INP_MaxAllowed = 4.0,
				},
				AutoFill = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn6",
					Name = "Auto-Fill / Fit to Scope",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				MatteMode = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn7",
					Name = "Matte Mode",
					INPID_InputControl = "ComboControl",
					INP_Integer = true,
					INP_Default = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
					INP_MinScale = 0,
					INP_MaxScale = 1,
				},
				OverlayOpacity = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn8",
					Name = "Overlay Opacity",
					INPID_InputControl = "SliderControl",
					INP_Default = 1.0,
					INP_MinAllowed = 0.0,
					INP_MaxAllowed = 1.0,
				},
				MatteRed = InstanceInput {
					SourceOp = "Background1",
					Source = "TopLeftRed",
					Name = "Matte Color",
					INPID_InputControl = "ColorControl",
					INP_Default = 0.0,
					INP_MinAllowed = 0.0,
					INP_MaxAllowed = 1.0,
					IC_ControlGroup = 1,
					IC_ControlID = 0,
				},
				MatteGreen = InstanceInput {
					SourceOp = "Background1",
					Source = "TopLeftGreen",
					INPID_InputControl = "ColorControl",
					INP_Default = 0.0,
					INP_MinAllowed = 0.0,
					INP_MaxAllowed = 1.0,
					IC_ControlGroup = 1,
					IC_ControlID = 1,
				},
				MatteBlue = InstanceInput {
					SourceOp = "Background1",
					Source = "TopLeftBlue",
					INPID_InputControl = "ColorControl",
					INP_Default = 0.0,
					INP_MinAllowed = 0.0,
					INP_MaxAllowed = 1.0,
					IC_ControlGroup = 1,
					IC_ControlID = 2,
				},
				BorderGuide = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn9",
					Name = "Border Guide",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				BorderWidth = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn10",
					Name = "Border Width",
					INPID_InputControl = "SliderControl",
					INP_Default = 2,
					INP_MinAllowed = 1,
