				RuleOfThirds = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn11",
					Name = "Rule of Thirds",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				GuideOpacity = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn12",
					Name = "Guide Opacity",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.75,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				CornerRadius = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn13",
					Name = "Corner Radius",
					INPID_InputControl = "SliderControl",
					INP_Default = 0,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 200,
				},
				FeatherPixels = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn14",
					Name = "Feather",
					INPID_InputControl = "SliderControl",
					INP_Default = 0,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 50,
				},
				GuidesInRender = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn15",
					Name = "Guides in Render",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				MatteInRender = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn16",
					Name = "Matte in Render",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				PreserveAlpha = InstanceInput {
					SourceOp = "Expression1",
					Source = "NumberIn17",
					Name = "Preserve Alpha",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
			},
			Outputs = ordered() {
				MainOutput1 = InstanceOutput {
					SourceOp = "Merge1",
					Source = "Output",
				},
			},
			Tools = ordered() {
				Expression1 = Expression {
					CtrlWZoom = false,
					Inputs = {
						NumberIn1 = Input { Value = 5, },
						NumberIn2 = Input { Value = 1.78, },
						NumberIn3 = Input { Value = 0.0, },
						NumberIn4 = Input { Value = 0.0, },
						NumberIn5 = Input { Value = 1.0, },
						NumberIn6 = Input { Value = 1.0, },
						NumberIn7 = Input { Value = 1.0, },
						NumberIn8 = Input { Value = 1.0, },
						NumberIn9 = Input { Value = 0.0, },
						NumberIn10 = Input { Value = 2.0, },
						NumberIn11 = Input { Value = 0.0, },
						NumberIn12 = Input { Value = 0.75, },
						NumberIn13 = Input { Value = 0.0, },
						NumberIn14 = Input { Value = 0.0, },
						NumberIn15 = Input { Value = 0.0, },
						NumberIn16 = Input { Value = 1.0, },
						NumberIn17 = Input { Value = 0.0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
				},
				Transform1 = Transform {
					CtrlWZoom = false,
					Inputs = {
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 - Expression1.NumberIn3 * 0.25, 0.5 - Expression1.NumberIn4 * 0.25)",
						},
						Size = Input {
							Expression = "Expression1.NumberIn5",
						},
						Edges = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 100 }, },
				},
				Background1 = Background {
					CtrlWZoom = false,
					Inputs = {
						Width = Input { Expression = "comp.RenderWidth", },
						Height = Input { Expression = "comp.RenderHeight", },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.0, },
						TopLeftGreen = Input { Value = 0.0, },
						TopLeftBlue = Input { Value = 0.0, },
						TopLeftAlpha = Input {
							Expression = "iif(Expression1.NumberIn7 == 0, 0, Expression1.NumberIn8)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 220 }, },
				},
				Rectangle1 = RectangleMask {
					CtrlWZoom = false,
					Inputs = {
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5, 0.5)",
						},
						Width = Input {
							Expression = "DAR = (comp.RenderWidth / comp.RenderHeight) * (comp:GetPrefs('Comp.FrameFormat.AspectX') / comp:GetPrefs('Comp.FrameFormat.AspectY')); T = iif(Expression1.NumberIn1 == 0, Expression1.NumberIn2, iif(Expression1.NumberIn1 == 1, 2.39, iif(Expression1.NumberIn1 == 2, 2.35, iif(Expression1.NumberIn1 == 3, 1.85, iif(Expression1.NumberIn1 == 4, 1.43, iif(Expression1.NumberIn1 == 5, 16/9, iif(Expression1.NumberIn1 == 6, 4/3, iif(Expression1.NumberIn1 == 7, 1.0, iif(Expression1.NumberIn1 == 8, 9/16, 4/5))))))))); iif(DAR >= T, T / DAR, 1.0)",
						},
						Height = Input {
							Expression = "DAR = (comp.RenderWidth / comp.RenderHeight) * (comp:GetPrefs('Comp.FrameFormat.AspectX') / comp:GetPrefs('Comp.FrameFormat.AspectY')); T = iif(Expression1.NumberIn1 == 0, Expression1.NumberIn2, iif(Expression1.NumberIn1 == 1, 2.39, iif(Expression1.NumberIn1 == 2, 2.35, iif(Expression1.NumberIn1 == 3, 1.85, iif(Expression1.NumberIn1 == 4, 1.43, iif(Expression1.NumberIn1 == 5, 16/9, iif(Expression1.NumberIn1 == 6, 4/3, iif(Expression1.NumberIn1 == 7, 1.0, iif(Expression1.NumberIn1 == 8, 9/16, 4/5))))))))); iif(DAR >= T, 1.0, DAR / T)",
						},
						SoftEdge = Input {
							Expression = "Expression1.NumberIn14 / comp.RenderWidth",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 330 }, },
				},
				Merge1 = Merge {
					CtrlWZoom = false,
					Inputs = {
						Background = Input {
							SourceOp = "Background1",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Transform1",
							Source = "Output",
						},
						EffectMask = Input {
							SourceOp = "Rectangle1",
							Source = "Mask",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 220 }, },
				},
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
				Flags = { AllowPan = true, AutoSnap = true, },
				Size = { 640, 480 },
			},
		},
	},
	ActiveTool = "Retscope",
}
